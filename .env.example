    # ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── OpenAI Realtime API ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=https://your-domain.com
SECRET_KEY=generate-a-random-secret-here
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-different-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Default Admin (optional) ─────────────────────────────────────────────────
# If omitted, a random password is generated on first boot and printed to stdout.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=your-strong-password

# ── Twilio TTS (fallback for TwiML, not used in Realtime path) ────────────────
TWILIO_VOICE=Google.en-GB-Neural2-A
TWILIO_LANGUAGE=en-GB

# ── WhatsApp (optional — leave empty to disable notifications) ────────────────
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
COOK_WHATSAPP_NUMBER=whatsapp:+44XXXXXXXXXX

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=1800
MAX_RECORD_SECONDS=15
